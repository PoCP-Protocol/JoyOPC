JOYOPC_ENV=dev
JOYOPC_DATABASE_URL=postgresql+psycopg://joyopc:joyopc@localhost:5432/joyopc
JOYOPC_SCHEMA_MODE=bootstrap
JOYOPC_WEB_DIR=../web
JOYOPC_STORAGE_DIR=./storage
JOYOPC_MAX_UPLOAD_MB=25

# Production: set JOYOPC_SCHEMA_MODE=migrate and run `alembic upgrade head` before starting the API.
# Start Postgres first: docker compose up -d postgres
# Tests use JOYOPC_ENV=test and do not require Postgres.

# Real multimodal provider (optional). Without a key JoyOPC stays in explicit local-structured mode.
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# JOYOPC_MULTIMODAL_MODEL=gpt-5.6-luna

# --- JoyOPC V0.4 real channel connectors ---
# Secrets are read from environment only. Never store live tokens in ChannelAccount.config_json.

# Shopify Admin GraphQL 2026-07
# SHOPIFY_SHOP_URL=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_...
# SHOPIFY_API_VERSION=2026-07
# ChannelAccount.store_domain should match SHOPIFY_SHOP_URL. Token never goes in the database.

# Amazon SP-API (private/self-authorized or public app credentials)
# AMAZON_SP_LWA_CLIENT_ID=...
# AMAZON_SP_LWA_CLIENT_SECRET=...
# AMAZON_SP_LWA_REFRESH_TOKEN=...
# AMAZON_SP_DEFAULT_PRODUCT_TYPE=TOYS_AND_GAMES
# ChannelAccount.seller_id and marketplace_id are stored as non-secret identifiers.

# TikTok Shop Open API
# TIKTOK_SHOP_APP_KEY=...
# TIKTOK_SHOP_APP_SECRET=...
# TIKTOK_SHOP_ACCESS_TOKEN=...
# ChannelAccount.shop_cipher is a shop identifier, not the access token.
# Optional endpoint overrides when TikTok releases a newer market-specific version:
# TIKTOK_SHOP_CREATE_PRODUCT_PATH=/product/202309/products
# TIKTOK_SHOP_SEARCH_ORDERS_PATH=/order/202309/orders/search
